+// ===== 遗忘深度体系（对标「词汇生长」分层抢救）=====
+// rescue = 用到第几层提示才想起（0=自己想起来，6=直接看答案）
+const DEPTH_RULES = {
+  green:  { max: 1, label: '记得牢', next: 1 },   // 🟢 0-1层：隔天复习
+  yellow: { max: 3, label: '有点生', next: 0 },   // 🟡 2-3层：当天再来一次 + 隔天
+  red:    { max: 6, label: '要攻克', next: 0 }    // 🔴 4层+：重点攻克，今天就再练
+};
+function calcDepth(rescue) {
+  if (rescue <= DEPTH_RULES.green.max) return 'green';
+  if (rescue <= DEPTH_RULES.yellow.max) return 'yellow';
+  return 'red';
+}
+function addDays(n) {
+  const d = new Date();
+  d.setDate(d.getDate() + n);
+  return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
+}
+function calcDue(depth) {
+  // 🟢 隔天复习 / 🟡 当天再来一次 / 🔴 当天重点攻克
+  if (depth === 'green') return addDays(1);
+  return addDays(0);
+}
+const DEPTH_RANK = { red: 0, yellow: 1, green: 2 };  // 复习区排序：越弱越靠前
+function depthLabel(depth) {
+  return depth === 'green' ? '记得牢' : depth === 'yellow' ? '有点生' : '要攻克';
+}
 
