+// ===== 盲说模式（生产模式：中→英）=====
+// 对标「词汇生长」分层抢救：先逼用户自己从中文产出英文，想不起来才逐层给提示。
+// 提示全部由句子自动计算生成，无需额外内容维护。
+let blindState = {};
+function blindSlot(i) {
+  if (!blindState[i]) blindState[i] = { level: 0, revealed: false, started: false };
+  return blindState[i];
+}
+function hintForSentence(en, zh, level) {
+  const words = (en || '').split(/\s+/).filter(w => w.length);
+  const isQ = /\?$/.test(en || '');
+  if (level === 1) return '这是一个' + (isQ ? '问句' : '陈述句') + '，一共 ' + words.length + ' 个词。';
+  if (level === 2) return '意思就是：' + escapeHtml(zh || '');
+  if (level === 3) return '第一个词是 <b>' + escapeHtml(words[0] || '') + '</b>';
+  if (level === 4) return '每个词的长度：' + words.map(w => w.replace(/[^A-Za-z0-9']/g, '').length).join(' ');
+  if (level === 5) return '前半句：<b>' + escapeHtml(words.slice(0, Math.ceil(words.length / 2)).join(' ')) + ' ...</b>';
+  if (level === 6) return '完整句子：<b>' + escapeHtml(en || '') + '</b>';
+  return null;
+}
+function recordRescue(sceneIdx, sentIdx, rescue) {
+  const key = sceneIdx + '-' + sentIdx;
+  const depth = calcDepth(rescue);
+  const st = state.sentenceStats[key] || { times: 0, greenStreak: 0 };
+  st.last = todayStr();
+  st.rescue = rescue;
+  st.depth = depth;
+  st.due = calcDue(depth);
+  st.times = (st.times || 0) + 1;
+  st.greenStreak = depth === 'green' ? (st.greenStreak || 0) + 1 : 0;
+  state.sentenceStats[key] = st;
+  saveState();
+  trackEvent('blind_rescue', { key: key, rescue: rescue, depth: depth, due: st.due });
+  return st;
+}
+function getDueReviews() {
+  const today = todayStr();
+  const out = [];
+  Object.keys(state.sentenceStats || {}).forEach(k => {
+    const st = state.sentenceStats[k];
+    if (st && st.due && st.due <= today) {
+      const p = k.split('-');
+      out.push({ sceneIdx: +p[0], sentIdx: +p[1], stat: st });
+    }
+  });
+  return out;
+}
+function todaySceneIdx() { return dayOfYear() % DAILY_SCENES.length; }
+function blindStart(key) { blindSlot(key).started = true; renderDaily(); }
+function blindHint(key) { const b = blindSlot(key); b.level = Math.min(6, b.level + 1); renderDaily(); }
+function blindGot(key, sceneIdx, sentIdx) {
+  const b = blindSlot(key);
+  const st = recordRescue(sceneIdx, sentIdx, b.level);
+  b.revealed = true;
+  showToast('记住程度：' + depthLabel(st.depth) + ' · 下次复习 ' + st.due, 4000);
+  renderDaily();
+}
+function blindGiveUp(key, sceneIdx, sentIdx) {
+  const b = blindSlot(key);
+  const st = recordRescue(sceneIdx, sentIdx, 6);
+  b.level = 6; b.revealed = true;
+  showToast('已标记：' + depthLabel(st.depth) + ' · 今天会再让你练一次', 4000);
+  renderDaily();
+}
+function blindReset(key) { blindState[key] = { level: 0, revealed: false, started: false }; renderDaily(); }
+function blindBoxHtml(key, sceneIdx, sentIdx, s) {
+  const b = blindSlot(key);
+  const st = state.sentenceStats[sceneIdx + '-' + sentIdx];
+  let html = '<div class="blind-box">';
+  html += '<div class="blind-zh">' + escapeHtml(s.zh) + '</div>';
+  if (st) {
+    const dueNow = st.due && st.due <= todayStr();
+    html += '<div style="margin-bottom:8px;"><span class="depth-badge depth-' + st.depth + '">' + depthLabel(st.depth) + '</span>' +
+            '<span class="blind-zh-under" style="margin-left:6px;">上次用到第 ' + (st.rescue || 0) + ' 层' +
+            (dueNow ? ' · <b style="color:var(--accent);">今天就再练一次</b>' : ' · 下次 ' + (st.due || '')) +
+            '</span></div>';
+  }
+  if (!b.started) {
+    html += '<div class="blind-actions">' +
+      '<button class="btn btn-primary btn-sm" onclick="blindStart(\'' + key + '\')">我想试试</button>' +
+      '<button class="btn btn-ghost btn-sm" onclick="blindGiveUp(\'' + key + '\',' + sceneIdx + ',' + sentIdx + ')">直接看答案</button></div>';
+  } else if (!b.revealed) {
+    html += '<div class="blind-actions">' +
+      '<button class="btn btn-primary btn-sm" onclick="blindGot(\'' + key + '\',' + sceneIdx + ',' + sentIdx + ')">我想起来了</button>' +
+      '<button class="btn btn-ghost btn-sm" onclick="blindHint(\'' + key + '\')">再给一层提示</button>' +
+      '<button class="btn btn-ghost btn-sm" onclick="blindGiveUp(\'' + key + '\',' + sceneIdx + ',' + sentIdx + ')">想不起来</button></div>';
+    if (b.level > 0) {
+      html += '<div class="blind-hints">';
+      for (let lv = 1; lv <= b.level; lv++) {
+        const h = hintForSentence(s.en, s.zh, lv);
+        if (h) html += '<div class="blind-hint">第 ' + lv + ' 层 · ' + h + '</div>';
+      }
+      html += '</div>';
+    }
+  } else {
+    html += '<div class="blind-en">' + escapeHtml(s.en) + '</div>' +
+      '<div class="blind-actions" style="margin-top:10px;">' +
+      '<button class="btn btn-ghost btn-sm" onclick="speak(\'' + s.en.replace(/'/g, "\\'") + '\')">听发音</button>' +
+      '<button class="btn btn-ghost btn-sm" onclick="blindReset(\'' + key + '\')">再来一次</button></div>';
+  }
+  html += '</div>';
+  return html;
+}
+// 复习区：遗忘深度到期的句子（三环之「复」——没有回收就没有记忆）
+function renderReviewSection(currentIdx) {
+  // 只回收往日场景的句子：今日场景已在主区，不重复显示
+  // 排序：要攻克 > 有点生 > 记得牢，最弱的排最前
+  const dues = getDueReviews()
+    .filter(d => d.sceneIdx !== currentIdx)
+    .sort((a, b) =>
+      (DEPTH_RANK[a.stat.depth] === undefined ? 9 : DEPTH_RANK[a.stat.depth]) -
+      (DEPTH_RANK[b.stat.depth] === undefined ? 9 : DEPTH_RANK[b.stat.depth]));
+  if (!dues.length) return '';
+  const redCount = dues.filter(d => d.stat.depth === 'red').length;
+  let html = '<div class="card"><div class="card-title">该复习了</div>';
+  html += '<div class="blind-zh-under" style="margin-bottom:10px;">' +
+    (redCount
