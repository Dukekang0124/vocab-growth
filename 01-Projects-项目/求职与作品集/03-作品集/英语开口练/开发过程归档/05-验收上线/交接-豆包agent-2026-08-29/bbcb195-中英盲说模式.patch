+      : '这些句子你上次卡住了。遗忘是数据不是失败——现在捡回来最省力。') + '</div>';
+  dues.slice(0, 6).forEach(d => {
+    const scene = DAILY_SCENES[d.sceneIdx];
+    if (!scene || !scene.sentences[d.sentIdx]) return;
+    const s = scene.sentences[d.sentIdx];
+    const isRed = d.stat.depth === 'red';
+    html += '<div class="sentence-item"' + (isRed ? ' style="border-color:rgba(255,107,107,.45);"' : '') + '>' +
+      '<div style="margin-bottom:6px;"><span class="depth-badge depth-' + d.stat.depth + '">' + depthLabel(d.stat.depth) + '</span>' +
+      '<span class="blind-zh-under" style="margin-left:6px;">来自「' + escapeHtml(scene.scene) + '」· 练过 ' + (d.stat.times || 1) + ' 次' +
+      (isRed ? ' · 上次用到第 ' + d.stat.rescue + ' 层' : '') + '</span></div>' +
+      blindBoxHtml('r' + d.sceneIdx + '-' + d.sentIdx, d.sceneIdx, d.sentIdx, s) +
+      '</div>';
+  });
+  html += '</div>';
+  return html;
+}
 function renderDaily() {
   const idx = dayOfYear() % DAILY_SCENES.length;
